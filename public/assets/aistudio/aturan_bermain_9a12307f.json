      "undo",
      "reset",
      "cek_jawaban"
    ],
    "aksesibilitas": {
      "tidak_wajib_drag": true,
      "teks_sesuai_pembaca_layar": true,
      "narasi_pecahan": true,
      "opsi_matikan_animasi": true,
      "opsi_matikan_audio": true,
      "warna_rasio_selalu_disertai_label_teks": true,
      "mode_tanpa_batas_waktu": true
    }
  },
  "mode": {
    "susun_rasio": {
      "instruksi": "Gunakan papan merah dan biru berdasarkan jumlah wajib; panjang total mencapai 1 utuh.",
      "aturan_validasi": [
        "jumlah_merah == jumlah_wajib.merah",
        "jumlah_biru == jumlah_wajib.biru",
        "jumlah_merah * rasio_target.biru == jumlah_biru * rasio_target.merah",
        "total_semua_papan == 1"
      ],
      "catatan": "Rasio misalnya 1:2 dapat diwakili 2 merah dan 4 biru; validasi jumlah wajib menjaga panjang tepat 1 utuh."
    },
    "susun_per_kelompok": {
      "instruksi": "Setiap suku penjumlahan memiliki daerah penyusunan terpisah. Isi setiap kelompok sesuai nilai suku; jembatan gabungan sepanjang hasil operasi.",
      "aturan_validasi": [
        "tiap_kelompok.total_pecahan == suku_terkait",
        "gabungan_seluruh_kelompok == target_panjang",
        "jumlah_papan_terpakai_per_jenis <= inventaris_per_jenis"
      ],
      "equivalent_fractions_allowed": true
    },
    "hapus_papan": {
      "instruksi": "Awalnya tampil jembatan yang terdiri dari papan satuan dengan nilai sama. Ketuk beberapa papan untuk membongkar bagian yang dikurangi.",
      "aturan_validasi": [
        "indeks_papan_terhapus_unik",
        "0 <= indeks_papan_terhapus < jumlah_papan_awal",
        "jumlah_pecahan_terhapus == operasi.dikurangi",
        "jumlah_pecahan_tersisa == operasi.hasil"
      ],
      "setelah_berhasil": "Tata ulang papan tersisa ke area target sehingga karakter bisa menyeberang."
    }
  },
  "matematika": {
    "representasi": "pecahan eksak berupa pasangan integer pembilang dan penyebut, penyebut > 0",
    "perkalian_silang": "a/b == c/d apabila a*d == c*b",
    "penjumlahan": "(a/b)+(c/d)=(a*d+c*b)/(b*d)",
    "pengurangan": "(a/b)-(c/d)=(a*d-c*b)/(b*d)",
    "rasio": "r:b = jumlahMerah:jumlahBiru bila jumlahMerah*b == jumlahBiru*r dan total papan sesuai panjang target",
    "sederhanakan": "Bagi pembilang dan penyebut dengan FPB; penyebut selalu positif.",
    "larangan": "Jangan gunakan pembandingan float, pembulatan, atau hanya lebar gambar sebagai sumber kebenaran."
  },
  "umpan_balik": {
    "benar": {
      "teks": "Hebat! Jembatanmu tepat. Ayo menyeberang!",
