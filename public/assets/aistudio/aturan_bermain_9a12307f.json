      "1/5": 144,
      "1/6": 120,
      "1/8": 90
    },
    "aturan_ukuran": "Lebar layar boleh diskalakan dengan faktor yang sama untuk semua papan. Jangan samakan lebar 1/2 dengan 1/4. Jangan hitung keberhasilan dari piksel; gunakan pecahan eksak.",
    "asset_root": "./",
    "latar": {
      "rasio_penjumlahan": "lingkungan/latar_sungai.png",
      "pengurangan_akhir": "lingkungan/latar_air_terjun.png"
