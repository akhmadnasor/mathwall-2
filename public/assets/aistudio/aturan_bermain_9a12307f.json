    "bahasa": "id-ID",
    "platform": "web-mobile-desktop",
    "sasaran": "SD kelas 4–5, dapat disesuaikan",
    "usia": "9–12 tahun",
    "mata_pelajaran": "Matematika",
    "materi": [
      "rasio",
      "penjumlahan pecahan",
      "pengurangan pecahan"
    ],
    "target_pembelajaran": [
      "Menginterpretasikan pecahan sebagai bagian dari satu panjang utuh.",
      "Menyusun rasio dari jumlah papan berwarna.",
      "Menjumlahkan pecahan dan menguji kesetaraan nilai.",
      "Mengurangi pecahan dengan melepas papan dan mengamati sisa."
    ],
    "orientasi": "edukatif; tanpa hukuman waktu; ramah layar sentuh"
  },
  "tampilan": {
    "rasio_aspek_dasar": "16:9",
    "viewport_desain_px": {
      "lebar": 1280,
