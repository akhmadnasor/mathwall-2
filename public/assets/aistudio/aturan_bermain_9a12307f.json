    "karakter_default": "karakter/utama_3d/adit_builder_3d.png"
  },
  "cara_bermain": [
    {
      "urutan": 1,
      "aksi": "pilih_karakter",
      "teks": "Pilih Adit atau Naya sebagai pembangun."
    },
    {
      "urutan": 2,
      "aksi": "pilih_level",
      "teks": "Mulai dari level 1; selanjutnya dibuka setelah misi benar."
    },
    {
      "urutan": 3,
      "aksi": "baca_misi",
      "teks": "Baca misi dan perhatikan angka atau rasio target."
    },
    {
      "urutan": 4,
      "aksi": "susun_atau_hapus",
      "teks": "Seret/ketuk papan ke posisi jembatan, atau ketuk papan untuk mengurangi."
    },
    {
      "urutan": 5,
      "aksi": "periksa",
      "teks": "Tekan tombol Cek Jawaban; penilaian memakai aritmetika pecahan eksak."
    },
    {
      "urutan": 6,
      "aksi": "lanjut",
      "teks": "Jika benar, jembatan selesai, karakter menyeberang, dan bintang diberikan."
    }
